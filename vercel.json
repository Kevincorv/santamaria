{
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200,
      "spa": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|avif|ico|gz|webm|mp4|mov|ttf|otf|woff|woff2)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}